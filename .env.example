IPTORRENTS_COOKIE="cf_clearance=...; pass=...; uid=..."
RUTORRENT_URL="https://example.com/rutorrent"
RUTORRENT_USERNAME=""
RUTORRENT_PASSWORD=""

# Slack bot (slack_bot.py) — socket mode
SLACK_BOT_TOKEN="xoxb-..."
SLACK_APP_TOKEN="xapp-..."
# Restrict the bot to a single Slack user ID (Profile → More → Copy member ID).
# Leave unset to allow the whole workspace.
SLACK_ALLOWED_USER=""

# Uptime Kuma "Push" monitor URL (dead-man's switch). The bot GETs this every
# 60s; if the pushes stop, Kuma alerts via Telegram. Optional — leave unset to
# disable heartbeat pushing. Create a Push monitor at status.tsteil.com to get it.
UPTIME_KUMA_PUSH_URL=""
